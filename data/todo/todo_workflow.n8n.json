  "nodes": [
    {
      "id": "n1",
      "name": "Every day at 6 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Run now",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "todo-digest",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "d09e1478-e0ce-45ad-a3b1-eca33d6af12e"
    },
    {
      "id": "n3",
      "name": "Fetch due todos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "http://directus:8055/items/todos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "directusApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,title,priority,due_date,notes"
            },
            {
              "name": "filter",
              "value": "={\"_and\":[{\"status\":{\"_eq\":\"open\"}},{\"due_date\":{\"_lte\":\"{{ $today.toFormat('yyyy-LL-dd') }}\"}}]}"
            },
            {
              "name": "sort",
              "value": "due_date"
            },
            {
              "name": "limit",
              "value": "-1"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "directusApi": {
          "id": "93fWPTzkBwCPgaWq",
          "name": "Directus account"
        }
      }
    },
    {
      "id": "n4",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.first().json.data || [];\nconst today = $today.toFormat('yyyy-LL-dd');\nconst rank = { high: 0, normal: 1, low: 2 };\nrows.sort((a, b) => ((rank[a.priority] ?? 1) - (rank[b.priority] ?? 1)) || String(a.due_date).localeCompare(String(b.due_date)));\nconst items = rows.map(r => ({ id: r.id, title: r.title, priority: r.priority, due_date: r.due_date, overdue: r.due_date < today }));\nconst overdue = items.filter(i => i.overdue).length;\nconst lines = [];\nlines.push(`Todos for ${$today.toFormat('ccc dd LLL yyyy')}: ${items.length} open` + (overdue ? ` (${overdue} overdue)` : ''));\nif (!items.length) lines.push('Nothing due today.');\nfor (const i of items) {\n  let line = `- [${String(i.priority).toUpperCase()}] ${i.title}`;\n  if (i.overdue) line += ` (overdue, was due ${i.due_date})`;\n  lines.push(line);\n}\nreturn [{ json: { date: today, todo_count: items.length, body: lines.join('\\n'), items } }];"
      }
    },
    {
      "id": "n5",
      "name": "Find today's digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "http://directus:8055/items/daily_digests",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "directusApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id"
            },
            {
              "name": "filter",
              "value": "={\"date\":{\"_eq\":\"{{ $json.date }}\"}}"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "directusApi": {
          "id": "93fWPTzkBwCPgaWq",
          "name": "Directus account"
        }
      }
    },
    {
      "id": "n6",
      "name": "Digest exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.data.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n7",
      "name": "Update digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=http://directus:8055/items/daily_digests/{{ $json.data[0].id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "directusApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Build digest').first().json) }}",
        "options": {}
      },
      "credentials": {
        "directusApi": {
          "id": "93fWPTzkBwCPgaWq",
          "name": "Directus account"
        }
      }
    },
