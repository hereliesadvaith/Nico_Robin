# Copy to .env on the server and fill in. Never commit .env.

# --- addressing -------------------------------------------------------
# n8n's hostname, no scheme.
N8N_DOMAIN=your-domain.com
# Full public URLs, no trailing slash.
N8N_PUBLIC_URL=https://your-domain.com
DIRECTUS_PUBLIC_URL=https://cms.your-domain.com

# --- secrets ----------------------------------------------------------
# openssl rand -hex 32 — must never change once workflows exist.
# Back this up off the server.
N8N_ENCRYPTION_KEY=
# openssl rand -hex 24
N8N_DB_PASSWORD=

# openssl rand -hex 16
DIRECTUS_KEY=
# openssl rand -hex 32 — signs tokens; changing it logs everyone out.
DIRECTUS_SECRET=
# openssl rand -hex 24
DIRECTUS_DB_PASSWORD=

# First-run Directus admin. Ignored once the account exists.
DIRECTUS_ADMIN_EMAIL=you@your-domain.com
DIRECTUS_ADMIN_PASSWORD=

# --- locale -----------------------------------------------------------
TZ=Asia/Kolkata
