# Copy to .env on the server and fill in. Never commit .env.

# --- addressing -------------------------------------------------------
# Public hostname, no scheme.
N8N_DOMAIN=your-domain.com
# Full public URL, no trailing slash.
N8N_PUBLIC_URL=https://your-domain.com

# Behind a reverse proxy (recommended) keep these as-is.
# Serving plain HTTP with no proxy: N8N_PROTOCOL=http, N8N_PROXY_HOPS=0,
# N8N_SECURE_COOKIE=false, N8N_BIND=0.0.0.0 — and see the README first.
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
# Interface n8n's port is published on. 127.0.0.1 keeps it off the internet.
N8N_BIND=127.0.0.1

# --- secrets ----------------------------------------------------------
# openssl rand -hex 32 — must never change once workflows exist.
# Back this up off the server.
N8N_ENCRYPTION_KEY=

# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- locale -----------------------------------------------------------
TZ=Asia/Kolkata
